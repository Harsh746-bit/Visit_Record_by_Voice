# Sarvam AI API Configuration (https://dashboard.sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_key_here

# Backend Security
ENVIRONMENT=development
SECRET_KEY=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///./visit_record_by_voice.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/visit_record_db

# Speech & LLM Settings
LLM_MODEL=sarvam-105b-conversations
